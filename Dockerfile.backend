FROM node:20-alpine

# Set workdir
WORKDIR /app

# Ensure dev environment
ENV NODE_ENV=development

# Install dependencies first (leverages Docker layer cache)
COPY package*.json ./
RUN npm ci

# Copy the rest of the project
COPY . .

# Expose backend port
EXPOSE 3001

# Start backend in watch mode
CMD ["npm", "run", "server:dev"]

